# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Initial Bootstrap Administrator Email
# Sets the initial madrasah administrator account.
# Note: For security, the user must sign in with this exact email and the email MUST be cryptographically verified (e.g. via Google Sign-In or verified email link).
# AI Studio users configure this via the Secrets or Environment Variables panel.
ADMIN_EMAIL="admin@example.com"

# Cloud SQL runtime database connection variables
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=

# Cloud SQL schema management and migration variables
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
